{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/node/**/*.ts"
  ]
}
