{
  "name": "jina-mcp",
  "version": "1.10.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "format": "biome format --write",
    "lint:fix": "biome lint --fix",
    "start": "node dist/node/main.js",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "build:node": "tsc -p tsconfig.node.json",
    "start:node": "node dist/node/main.js",
    "test": "npm run build:node && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.3",
    "jose": "^6.2.13",
    "undici": "^7.30.1",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/node": "^24.2.1",
    "agents": "^0.3.6",
    "typescript": "5.8.3",
    "wrangler": "^4.28.1"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  }
}
